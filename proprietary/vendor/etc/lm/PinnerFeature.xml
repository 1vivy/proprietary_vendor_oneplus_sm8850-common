<Feature>
    <Name>Pinner</Name>
    <Libname>libpinner.so</Libname>
    <Meters>
        <Meter>
            <Name>Pinner</Name>
            <Triggers>
                <Trigger>
                    <Primary>False</Primary>
                    <AsyncId>VENDOR_HINT_PIN_FILE</AsyncId>
                    <AsyncType>0</AsyncType>
                </Trigger>
                <Trigger>
                    <Primary>False</Primary>
                    <AsyncId>VENDOR_HINT_UNPIN_FILE</AsyncId>
                    <AsyncType>0</AsyncType>
                </Trigger>
            </Triggers>
            <Samples>1</Samples>
        </Meter>
    </Meters>
</Feature>
